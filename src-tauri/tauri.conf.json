{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowM",
  "version": "0.0.0",
  "identifier": "com.flowm.app",
  "build": {
    "beforeDevCommand": "npm run dev:desktop",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run desktop:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowM",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/flowm-harness"],
    "resources": {
      "../third_party/codex/LICENSE": "licenses/codex-LICENSE",
      "../third_party/codex/NOTICE": "licenses/codex-NOTICE",
      "binaries/runtime-manifest.json": "harness-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
